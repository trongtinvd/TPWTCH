{
  "_doc": "the player avatars (Docs/AVATARS.md). characters[] in selection order. A character: id, name, model (a GLB path, null = the placeholder humanoid built from 'body'), body (placeholder proportions, materials, named parts), visual (scale / offset / rotationDeg / heightOffset), icon ({image: PNG path, label, background, color, ring}; no image = a generated icon), animations (an animation set name or an inline set), outfits[], defaultOutfit. An outfit: id, name, model (optional GLB that replaces the character's), meshes {show, hide} (node names), materials {name: '#rrggbb' or {color, emissive, metalness, roughness}}, parts (extra placeholder parts), visual, stats (config/stats.json ids), abilities [{id, name, text}] (none yet: the flavor text is shown), flavor, icon, animations (optional, replaces the character's). sideView: where the avatars stand in the 3D side view.",
  "sideView": { "behind": 3.2, "offsetX": 0, "height": 0, "scale": 2.4 },
  "animationSets": {
    "humanoid": {
      "defaults": { "interpolation": { "method": "crossfade", "duration": 0.25 } },
      "animations": {
        "enter": [
          { "id": "enter_drop", "procedural": "drop" },
          { "id": "enter_spin", "procedural": "spin_in" }
        ],
        "idle": [
          { "id": "idle_breathe", "procedural": "breathe" },
          { "id": "idle_sway", "procedural": "sway" }
        ],
        "idle_wounded": [{ "id": "wounded_slump", "procedural": "slump", "weight": 1 }],
        "dies": [
          { "id": "dies_fall", "procedural": "fall" },
          { "id": "dies_kneel", "procedural": "kneel" }
        ],
        "playing_card": [
          { "id": "card_cast", "procedural": "cast" },
          { "id": "card_throw", "procedural": "throw" }
        ]
      },
      "transitions": [
        { "from": "idle_breathe", "to": "card_cast", "interpolation": { "method": "ease", "duration": 0.2 } },
        { "from": "card_throw", "to": "idle_sway", "interpolation": { "method": "crossfade", "duration": 0.45 } }
      ]
    },
    "robot": {
      "defaults": { "interpolation": { "method": "crossfade", "duration": 0.2 } },
      "animations": {
        "enter": [{ "id": "enter_boot", "procedural": "boot" }],
        "idle": [
          { "id": "idle_hover", "procedural": "hover" },
          { "id": "idle_scan", "procedural": "sway" }
        ],
        "idle_wounded": [{ "id": "wounded_glitch", "procedural": "glitch", "weight": 1 }],
        "dies": [{ "id": "dies_shutdown", "procedural": "shutdown" }],
        "playing_card": [
          { "id": "card_beam", "procedural": "cast", "speed": 1.2 },
          { "id": "card_toss", "procedural": "throw" }
        ]
      },
      "transitions": []
    }
  },
